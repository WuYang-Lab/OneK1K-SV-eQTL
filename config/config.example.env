# Copy to config/config.env and replace every /path/to/... value.
# Use absolute paths. Do not commit config/config.env.

# Project outputs
PROJECT_ROOT=/path/to/OneK1K_SV_eQTL_run

# Input SNP genotype set in PLINK 1 bed/bim/fam format, currently hg19/GRCh37
BFILE_HG19=/path/to/cohort.genotypes.hg19

# Genome resources
LIFTOVER_BIN=liftOver
HG19_TO_HG38_CHAIN=/path/to/hg19ToHg38.over.chain
HG38_FASTA=/path/to/GRCh38.fa

# ImputeSV reference panels (bgzip-compressed and tabix-indexed)
SV_REFERENCE_VCF=/path/to/SV_panel_GRCh38.vcf.gz
VNTR_REFERENCE_VCF=/path/to/VNTR_panel_GRCh38.vcf.gz

# Beagle 5.x JAR
BEAGLE_JAR=/path/to/beagle.jar
BEAGLE_MEMORY_GB=32
NTHREADS=16

# Chromosomes: one value per non-comment line
CHROMOSOMES_FILE=/path/to/OneK1K-SV-eQTL/config/chromosomes.txt

# Post-imputation filters. These reproduce the original OneK1K choices.
DR2_MIN=0.3
MAF_MIN=0.01
MAF_MAX=0.99
GENO_MAX=0.05
HWE_MIN=1e-6

# TensorQTL inputs. The literal token {cell_type} is replaced at runtime.
CELL_TYPES_FILE=/path/to/OneK1K-SV-eQTL/config/cell_types.example.txt
PHENOTYPE_TEMPLATE=/path/to/phenotypes/{cell_type}.bed.gz
COVARIATE_TEMPLATE=/path/to/phenotypes/{cell_type}.covariates.tsv

# TensorQTL parameters
CIS_WINDOW=1000000
TENSORQTL_PERMUTATIONS=10000
TENSORQTL_FDR=0.05
TENSORQTL_MAF=0.01
TRANS_PVAL_THRESHOLD=1e-5

# Optional joint SNP+SV analysis: hg38 SNP PLINK bed/bim/fam prefix
SNP_BFILE_HG38=/path/to/cohort.snps.hg38.qc
